# API Configuration Template
# Copy this file to .env and fill in your API keys

# OpenAI API Key (required for OpenAI client and LiteLLM with OpenAI models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (optional, for Claude models via LiteLLM)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Cohere API Key (optional, for Command models via LiteLLM)
# COHERE_API_KEY=your-cohere-api-key-here

# Google API Key (optional, for Gemini models via LiteLLM)
# GOOGLE_API_KEY=your-google-api-key-here

# Hugging Face API Key (optional, for HF models via LiteLLM)
# HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# Azure OpenAI Configuration (optional)
# AZURE_API_KEY=your-azure-api-key-here
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2023-05-15

# Additional LiteLLM supported providers:
# - Replicate
# - Together AI
# - Ollama (for local models)
# - And many more...

# Note: You can also pass API keys directly to the client constructors
# instead of using environment variables for better security.
